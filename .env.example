# Database
# Local Postgres database used by the development app.
SERVER_DATABASE_URL=postgresql://postgres:postgres@localhost/zbav_se_me

# Alternative database URLs for quick local switching.
# staging
# SERVER_DATABASE_URL=postgresql://user:password@staging-host/database?sslmode=require
# dev
# SERVER_DATABASE_URL=postgresql://user:password@dev-host/database?sslmode=require
# test
# SERVER_DATABASE_URL=postgresql://postgres:postgres@localhost/test

# App URLs and assets
# Public app origin and content locations used by Vite and server-side URL building.
VITE_ORIGIN=https://zbav-se.me.localhost:1355
VITE_CONTENT_CDN=https://content.zbav-se.me
VITE_APP_ASSETS=/

# Auth and request security
# Local-only secrets for Better Auth, JWT signing, and HMAC-based request hashing.
SERVER_BETTER_AUTH_SECRET=1234567812345678123456781234567812345678123456781234567812345678
SERVER_HMAC_SECRET=1234567812345678123456781234567812345678123456781234567812345678
SERVER_JWT_SECRET=your-jwt-secret-key-here

# External APIs
# Third-party service tokens used by app features.
SERVER_GEOAPIFY_TOKEN=xxx
SERVER_GITHUB=xxx

# Storage
# Bunny S3-compatible storage used for uploads.
SERVER_S3_API=de-s3.storage.bunnycdn.com
SERVER_S3_BUCKET=zbav-se-me-upload
SERVER_S3_KEY=xxx
SERVER_S3_SECRET=xxx

# Stripe
# Stripe API key and the local webhook secret printed by `bun run dev:stripe`.
SERVER_STRIPE_SECRET=rk_test_xxx
SERVER_STRIPE_WEBHOOK_SECRET=whsec_xxx

# AI
# Agent model endpoint. Switch SERVER_AI_SERVER_URL or SERVER_AI_MODEL when testing another provider/model.
SERVER_AI_TOKEN=xxx
SERVER_AI_SERVER_URL=http://localhost:1234/v1
# SERVER_AI_SERVER_URL=https://api.kilo.ai/api/gateway
SERVER_AI_MODEL=qwen/qwen3.6-35b-a3b
# SERVER_AI_MODEL=qwen/qwen3.6-27b

# Mail
# Local SMTP delivery and Mailpit UI used during development.
SERVER_SMTP_HOST=127.0.0.1
SERVER_SMTP_PORT=1025
SERVER_SMTP_USERNAME=mailpit
SERVER_SMTP_PASSWORD=mailpit
SERVER_SMTP_FROM=Zbavík <info@zbav-se.me>
MAILPIT_BASE_URL=http://127.0.0.1:8025

# Internal operations
# Tokens required by protected maintenance endpoints.
SERVER_MIGRATION_TOKEN=1234
SERVER_CRON_TOKEN=4321

# Local runtime
# Node, TLS, CORS, debug, and Nitro settings for local development.
NODE_OPTIONS=--max-old-space-size=2400
NODE_USE_SYSTEM_CA=1
NODE_EXTRA_CA_CERTS="$HOME/.portless/ca.pem"
ALLOWED_ORIGINS=http://localhost:6274,http://127.0.0.1:6274,https://zbav-se.me.localhost:1355,https://zbav-se.me
SERVER_DEBUG_DELAY_MS=0
NITRO_PRESET=node_server

{
	"$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/*",
			"!**/_route.ts",
			"!**/dist",
			"!**/.output",
			"!**/.nitro",
			"!**/.vercel",
			"!**/.tanstack",
			"!**/sdk/src/api",
			"!**/apps/blog/.docusaurus",
			"!**/apps/blog/build"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"attributePosition": "multiline",
		"bracketSameLine": false,
		"bracketSpacing": true,
		"expand": "always",
		"formatWithErrors": false,
		"lineEnding": "lf",
		"indentWidth": 4,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"domains": {
			"react": "all"
		},
		"rules": {
			"recommended": true,
			"a11y": {
				"noLabelWithoutControl": "off",
				"useKeyWithClickEvents": "off",
				"useHtmlLang": "off",
				"noStaticElementInteractions": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noAssignInExpressions": "off"
			},
			"security": {
				"noDangerouslySetInnerHtml": "off"
			},
			"style": {
				"useComponentExportOnlyModules": "off",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": [
									"~/app/@seller-user/draft/**",
									"!~/app/@seller-user/draft/~public/**"
								],
								"message": "Use public import"
							},
							{
								"group": [
									"~/app/@buyer-user/feed/**",
									"!~/app/@buyer-user/feed/~public/**"
								],
								"message": "Use public import"
							}
						]
					}
				}
			},
			"correctness": {
				"useHookAtTopLevel": "off"
			},
			"complexity": {
				"noBannedTypes": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"jsxQuoteStyle": "double",
			"attributePosition": "multiline",
			"expand": "always",
			"quoteProperties": "asNeeded",
			"trailingCommas": "all",
			"arrowParentheses": "always",
			"semicolons": "always"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}

{
	"name": "@use-pico/client",
	"description": "Client-side stuff",
	"version": "workspace:*",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build:bundle": "bun x rollup -c",
		"no:build": "bun run build:bundle"
	},
	"dependencies": {
		"@floating-ui/react": "0.27.17",
		"@tanstack/react-query": "5.90.20",
		"@tanstack/react-router": "1.157.16",
		"@types/luxon": "3.7.1",
		"@use-pico/cls": "workspace:*",
		"@use-pico/common": "workspace:*",
		"axios": "1.13.4",
		"kysely": "0.28.10",
		"luxon": "3.7.2",
		"motion": "12.29.2",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-dropzone": "14.4.0",
		"react-markdown": "10.1.0",
		"react-modal-sheet": "5.2.1",
		"remark-gfm": "4.0.1",
		"ts-pattern": "5.9.0",
		"use-debounce": "10.1.0",
		"zod": "4.3.6",
		"zustand": "5.0.10"
	},
	"devDependencies": {
		"@aminnairi/rollup-plugin-external": "0.1.3",
		"@rollup/plugin-commonjs": "29.0.0",
		"@rollup/plugin-node-resolve": "16.0.3",
		"@rollup/plugin-typescript": "12.3.0",
		"@types/node": "25.1.0",
		"@types/react": "19.2.10",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"@use-pico/tsconfig": "5.0.0",
		"rollup": "4.57.1",
		"rollup-plugin-dts": "6.3.0",
		"typescript": "5.9.3"
	},
	"files": [
		"src"
	],
	"exports": {
		"./ui/*": {
			"import": "./src/ui/*/index.ts"
		},
		"./ui.css": "./src/ui.css",
		"./*": {
			"import": "./src/*/index.ts"
		}
	},
	"license": "MIT",
	"repository": "use-pico/pico",
	"homepage": "https://github.com/use-pico/pico#readme",
	"bugs": "https://github.com/use-pico/pico/issues"
}

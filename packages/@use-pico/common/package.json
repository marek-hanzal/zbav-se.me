{
	"name": "@use-pico/common",
	"description": "Shared stuff between client/server.",
	"version": "workspace:*",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"typecheck": "tsgo --noEmit",
		"no:build": "bun x rollup -c",
		"no:test": "vitest --run"
	},
	"dependencies": {
		"@apollo/client": "4.1.3",
		"@graphql-typed-document-node/core": "3.2.0",
		"@paralleldrive/cuid2": "3.3.0",
		"@types/is-callable": "1.1.2",
		"@types/is-empty": "1.2.3",
		"@types/luxon": "3.7.1",
		"@types/qs": "6.14.0",
		"effect": "3.19.15",
		"fast-clean": "1.5.3",
		"flattie": "1.1.1",
		"is-callable": "1.2.7",
		"is-empty": "1.2.0",
		"is-string": "1.1.1",
		"js-sha256": "0.11.1",
		"kysely": "0.28.10",
		"luxon": "3.7.2",
		"preferred-locale": "2.0.2",
		"qs": "6.14.1",
		"ts-pattern": "5.9.0",
		"xxhash-wasm": "1.1.0",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@rollup/plugin-commonjs": "29.0.0",
		"@rollup/plugin-node-resolve": "16.0.3",
		"@rollup/plugin-typescript": "12.3.0",
		"@types/node": "25.1.0",
		"@types/react": "19.2.10",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"@use-pico/tsconfig": "5.0.0",
		"rollup": "4.57.1",
		"rollup-plugin-dts": "6.3.0",
		"typescript": "5.9.3",
		"vitest": "4.0.18"
	},
	"files": [
		"src"
	],
	"exports": {
		"./*": {
			"types": "./src/*/index.ts",
			"import": "./src/*/index.ts"
		}
	},

{
	"name": "@zbav-se.me/ui",
	"description": "Common UI components used in the zbav-se.me project",
	"version": "workspace:*",
	"type": "module",
	"scripts": {
		"typecheck": "tsgo --noEmit",
		"knip": "knip --include dependencies --no-config-hints"
	},
	"dependencies": {
		"@tanstack/react-form": "1.28.5",
		"@tanstack/react-query": "5.95.2",
		"@use-pico/client": "workspace:*",
		"@use-pico/cls": "workspace:*",
		"@use-pico/common": "workspace:*",
		"react": "19.2.4"
	},
	"devDependencies": {
		"@types/node": "25.5.0",
		"@types/react": "19.2.14",
		"@typescript/native-preview": "7.0.0-dev.20260327.2",
		"@use-pico/tsconfig": "5.0.0",
		"knip": "6.0.6",
		"typescript": "beta"
	},
	"exports": {
		"./ui.css": "./src/ui.css",
		"./*": {
			"import": "./src/*/index.ts",
			"require": "./src/*/index.ts"
		}
	}
}

{
	"name": "@zbav-se.me/sdk",
	"version": "workspace:*",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"sdk": "openapi-ts",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"@use-pico/client": "workspace:*",
		"@use-pico/common": "workspace:*",
		"@use-pico/server": "workspace:*",
		"axios": "1.13.5",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@hey-api/openapi-ts": "0.92.4",
		"@types/node": "25.3.0",
		"@typescript/native-preview": "7.0.0-dev.20260223.1",
		"@use-pico/tsconfig": "5.0.0",
		"typescript": "beta",
		"vite": "8.0.0-beta.15"
	},
	"exports": {
		"./api/*": {
			"import": "./src/api/*/index.ts",
			"require": "./src/api/*/index.ts"
		},
		"./mutation/*": {
			"import": "./src/mutation/*/index.ts",
			"require": "./src/mutation/*/index.ts"
		},
		"./query/*": {
			"import": "./src/query/*/index.ts",
			"require": "./src/query/*/index.ts"
		}
	}
}

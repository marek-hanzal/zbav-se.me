{
	"name": "marek-hanzal/zbav-se.me",
	"description": "Simple but clever c2c marketplace",
	"version": "workspace:*",
	"scripts": {
		"dev": "dotenv -c development -- turbo run dev",
		"build": "dotenv -c development -- turbo run build",
		"e2e": "dotenv -c development -- bun run --cwd ./apps/e2e e2e",
		"sdk": "dotenv -c development -- bunx turbo run sdk",
		"translations": "turbo run translations",
		"format": "biome format --write .",
		"lint": "biome check --write .",
		"knip": "turbo run knip --concurrency=1",
		"typecheck": "turbo run typecheck",
		"test": "dotenv -c development -- turbo run test",
		"seed:core": "dotenv -c development -- bun --cwd ./apps/server ./cli/seed-core.ts",
		"seed:interaction": "dotenv -c development -- bun --cwd ./apps/server ./cli/seed-interaction.ts",
		"env:sync": "bun ./cli/env-sync.ts",
		"update": "bun update",
		"sp:fix": "bunx syncpack fix",
		"sp:format": "bunx syncpack format",
		"sp:update": "bunx syncpack update",
		"workflow:format": "run-s sp:format format",
		"workflow:check": "run-s workflow:format lint typecheck",
		"workflow:test": "run-p test e2e",
		"workflow:update": "run-s sp:fix sp:update sp:fix sp:update workflow:format update workflow:check"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.9",
		"@types/node": "25.5.0",
		"dotenv-cli": "11.0.0",
		"npm-run-all2": "8.0.4",
		"syncpack": "14.2.1",
		"turbo": "2.8.20",
		"typescript": "beta"
	},
	"license": "MIT",
	"repository": "marek-hanzal/zbav-se.me.git",
	"overrides": {
		"@types/react": "19.2.14",
		"kysely": "0.28.14"
	},
	"packageManager": "bun@1.3.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/**/*"
	]
}

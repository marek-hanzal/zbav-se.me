{
	"name": "@zbav-se.me/app",
	"description": "User-land (mobile) application for zbav-se.me",
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "dotenv -c development -- portless zbav-se.me vite",
		"build": "dotenv -c development -- vite build",
		"e2e:build": "dotenv -c development -- NITRO_PRESET=node_server vite build --mode production",
		"e2e:start": "portless --force zbav-se.me node .output/server/index.mjs",
		"e2e": "run-s e2e:build e2e:start",
		"seed:core": "bun ./cli/seed-core.ts",
		"seed:interaction": "bun ./cli/seed-interaction.ts",
		"translations": "bun ./cli/translations.ts",
		"dc": "depcruise src --output-type err-long",
		"knip": "knip --include dependencies --no-config-hints",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"lint": "biome check --write .",
		"test": "dotenv -c development -- vitest run",
		"env:sync": "bun ./cli/env-sync.ts",
		"update": "bun update",
		"sp:fix": "bunx syncpack fix",
		"sp:format": "bunx syncpack format",
		"sp:update": "bunx syncpack update",
		"workflow:format": "run-s sp:format format",
		"workflow:check": "run-s workflow:format lint dc typecheck",
		"workflow:test": "run-p test e2e",
		"workflow:update": "run-s sp:fix sp:update workflow:format update workflow:check"
	},
	"dependencies": {
		"@better-auth/passkey": "1.5.6",
		"@escapace/accept-language-parser": "2.1.2",
		"@paralleldrive/cuid2": "3.3.0",
		"@phenomnomnominal/tsquery": "6.1.4",
		"@tanstack/query-async-storage-persister": "5.96.0",
		"@tanstack/query-core": "5.96.0",
		"@tanstack/query-persist-client-core": "5.96.0",
		"@tanstack/react-form": "1.28.6",
		"@tanstack/react-query": "5.96.0",
		"@tanstack/react-query-persist-client": "5.96.0",
		"@tanstack/react-router": "1.168.10",
		"@tanstack/react-router-ssr-query": "1.166.10",
		"@tanstack/react-start": "1.167.16",
		"axios": "1.14.0",
		"better-auth": "1.5.6",
		"cac": "7.0.0",
		"cli-progress": "3.12.0",
		"effect": "3.21.0",
		"fast-clean": "1.5.3",
		"jose": "6.2.2",
		"kysely": "0.28.15",
		"luxon": "3.7.2",
		"minio": "8.0.7",
		"motion": "12.38.0",
		"pg": "8.20.0",
		"pg-pool": "3.13.0",
		"pg-protocol": "1.13.0",
		"pgvector": "0.2.1",
		"qs": "6.15.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-markdown": "10.1.0",
		"react-modal-sheet": "5.6.0",
		"reflect-metadata": "0.2.2",
		"remark-gfm": "4.0.1",
		"sonner": "2.0.7",
		"tailwind-merge": "3.5.0",
		"terminal-kit": "3.1.2",
		"timer-node": "5.0.9",
		"ts-pattern": "5.9.0",
		"use-debounce": "10.1.1",
		"yaml": "2.8.3",
		"zod": "4.3.6",
		"zustand": "5.0.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@iconify/json": "2.2.458",
		"@iconify/tailwind4": "1.2.3",
		"@modyfi/vite-plugin-yaml": "1.1.1",
		"@playwright/test": "1.58.2",
		"@tailwindcss/vite": "4.2.2",
		"@tanstack/router-plugin": "1.167.12",
		"@types/bun": "1.3.11",
		"@types/cli-progress": "3.11.6",
		"@types/luxon": "3.7.1",
		"@types/node": "25.5.0",
		"@types/pg": "8.20.0",
		"@types/pg-pool": "2.0.7",
		"@types/qs": "6.15.0",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@types/terminal-kit": "2.5.7",
		"@typescript/native-preview": "7.0.0-dev.20260331.1",
		"@use-pico/vite-asset-size": "1.0.4",
		"@vitejs/plugin-react": "6.0.1",
		"dependency-cruiser": "17.3.10",
		"dotenv-cli": "11.0.0",
		"google-fonts-helper": "3.7.4",
		"js-sha256": "0.11.1",
		"knip": "6.1.1",
		"nitro": "3.0.260311-beta",
		"npm-run-all2": "8.0.4",
		"syncpack": "14.3.0",
		"tailwindcss": "4.2.2",
		"typescript": "beta",
		"vite": "8.0.3",
		"vitest": "4.1.2"
	},
	"license": "MIT",
	"repository": "marek-hanzal/zbav-se.me.git",
	"packageManager": "bun@1.3.0",
	"private": true
}

{
	"name": "marek-hanzal/zbav-se.me",
	"description": "Simple but clever c2c marketplace",
	"version": "workspace:*",
	"scripts": {
		"dev": "dotenv -c development -- turbo run dev --parallel",
		"build": "dotenv -c development -- turbo run build --parallel",
		"preview": "dotenv -c development -- turbo run preview --parallel",
		"sdk": "dotenv -c development -- bun x turbo run sdk",
		"translations": "turbo run translations --parallel",
		"format": "biome format --write .",
		"lint": "biome check --write .",
		"knip": "turbo run knip --parallel",
		"typecheck": "turbo run typecheck --parallel",
		"test": "dotenv -c development -- turbo run test --parallel",
		"update": "bun update --linker=isolated",
		"sp:fix": "bun x syncpack fix-mismatches",
		"sp:format": "bun x syncpack format",
		"sp:update": "bun x syncpack update",
		"workflow:format": "run-s sp:format format",
		"workflow:check": "run-s workflow:format lint typecheck",
		"workflow:update": "run-s sp:fix sp:update sp:fix sp:update workflow:format update workflow:check"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@types/node": "25.0.6",
		"dotenv-cli": "11.0.0",
		"npm-run-all2": "8.0.4",
		"syncpack": "13.0.4",
		"turbo": "2.7.4",
		"typescript": "5.9.3"
	},
	"license": "MIT",
	"repository": "marek-hanzal/zbav-se.me.git",
	"overrides": {
		"@types/react": "19.2.8"
	},
	"packageManager": "bun@1.3.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/**/*"
	]
}

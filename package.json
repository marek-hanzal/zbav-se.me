{
	"name": "@zbav-se.me/app",
	"description": "zbav-se.me - clever c2c for everyone!",
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "dotenv -c development -- portless zbav-se.me vite",
		"build": "dotenv -c development -- vite build",
		"e2e:build": "dotenv -c development -- vite build --mode production",
		"e2e:start": "dotenv -c development -- portless --force zbav-se.me node .output/server/index.mjs",
		"e2e": "dotenv -c development -- playwright test --project=mobile",
		"e2e:ui": "dotenv -c development -- playwright test --headed --project=dev",
		"e2e:dev": "dotenv -c development -- playwright test --ui --project=dev",
		"seed": "bun ./cli/seed.ts",
		"translations": "bun ./cli/translations.ts",
		"dc": "depcruise src --output-type err-long",
		"knip": "knip --include dependencies --no-config-hints",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"lint": "biome check --write .",
		"test": "dotenv -c development -- vitest run",
		"env:sync": "bun ./cli/env-sync.ts",
		"update": "bun update",
		"sp:fix": "bunx syncpack fix",
		"sp:format": "bunx syncpack format",
		"sp:update": "bunx syncpack update",
		"workflow:format": "run-s sp:format format",
		"workflow:check": "run-s workflow:format typecheck lint dc knip build",
		"workflow:test": "run-p test e2e",
		"workflow:update": "run-s sp:fix sp:update workflow:format update workflow:check"
	},
	"dependencies": {
		"@escapace/accept-language-parser": "2.1.2",
		"@inkjs/ui": "2.0.0",
		"@logtape/file": "2.0.9",
		"@logtape/logtape": "2.0.9",
		"@logtape/pretty": "2.0.9",
		"@openai/agents": "0.11.4",
		"@openai/agents-core": "0.11.4",
		"@paralleldrive/cuid2": "3.3.0",
		"@phenomnomnominal/tsquery": "6.2.0",
		"@react-email/components": "1.0.12",
		"@react-email/render": "2.0.8",
		"@tanstack/query-async-storage-persister": "5.100.10",
		"@tanstack/react-form": "1.32.0",
		"@tanstack/react-pacer": "0.22.1",
		"@tanstack/react-query": "5.100.10",
		"@tanstack/react-query-persist-client": "5.100.10",
		"@tanstack/react-router": "1.170.3",
		"@tanstack/react-router-ssr-query": "1.167.0",
		"@tanstack/react-start": "1.168.5",
		"axios": "1.16.1",
		"better-auth": "1.6.11",
		"cli-progress": "3.12.0",
		"csv-stringify": "6.7.0",
		"effect": "3.21.2",
		"eventsource-parser": "3.0.8",
		"fast-clean": "1.5.3",
		"gray-matter": "4.0.3",
		"ink": "7.0.3",
		"js-sha256": "0.11.1",
		"kysely": "0.29.2",
		"luxon": "3.7.2",
		"minio": "8.0.7",
		"motion": "12.38.0",
		"pg": "8.20.0",
		"pg-pool": "3.13.0",
		"pg-protocol": "1.13.0",
		"pgvector": "0.2.1",
		"qs": "6.15.2",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"react-markdown": "10.1.0",
		"react-modal-sheet": "5.6.0",
		"remark-gfm": "4.0.1",
		"resend": "6.12.3",
		"tailwind-merge": "3.6.0",
		"timer-node": "5.0.9",
		"ts-pattern": "5.9.0",
		"yaml": "2.9.0",
		"zod": "4.4.3",
		"zustand": "5.0.13"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@iconify/json": "2.2.474",
		"@iconify/tailwind4": "1.2.3",
		"@modyfi/vite-plugin-yaml": "1.1.1",
		"@playwright/test": "1.60.0",
		"@tailwindcss/vite": "4.3.0",
		"@tanstack/router-plugin": "1.168.5",
		"@types/bun": "1.3.14",
		"@types/cli-progress": "3.11.6",
		"@types/luxon": "3.7.1",
		"@types/node": "25.8.0",
		"@types/pg": "8.20.0",
		"@types/pg-pool": "2.0.7",
		"@types/qs": "6.15.1",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.2",
		"@vitest/coverage-v8": "4.1.6",
		"dependency-cruiser": "17.4.0",
		"dotenv-cli": "11.0.0",
		"google-fonts-helper": "3.7.4",
		"knip": "6.14.1",
		"nitro": "3.0.260429-beta",
		"npm-run-all2": "8.0.4",
		"syncpack": "15.1.2",
		"tailwindcss": "4.3.0",
		"typescript": "6.0.3",
		"vite": "8.0.13",
		"vitest": "4.1.6"
	},
	"license": "MIT",

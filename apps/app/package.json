{
	"name": "@zbav-se.me/app",
	"description": "User-land (mobile) application for zbav-se.me",
	"version": "workspace:*",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"dev": "portless zbav-se.me vite",
		"e2e:build": "NITRO_PRESET=node_server vite build --mode production",
		"e2e:start": "portless --force zbav-se.me node .output/server/index.mjs",
		"e2e": "run-s e2e:build e2e:start",
		"seed:core": "bun ./cli/seed-core.ts",
		"seed:interaction": "bun ./cli/seed-interaction.ts",
		"translations": "bun ./cli/translations.ts",
		"typecheck": "tsc --noEmit",
		"knip": "knip --include dependencies --no-config-hints"
	},
	"dependencies": {
		"@better-auth/passkey": "1.5.6",
		"@escapace/accept-language-parser": "2.1.2",
		"@hono/zod-openapi": "1.2.3",
		"@tanstack/query-async-storage-persister": "5.95.2",
		"@tanstack/query-core": "5.95.2",
		"@tanstack/query-persist-client-core": "5.95.2",
		"@tanstack/react-query": "5.95.2",
		"@tanstack/react-query-persist-client": "5.95.2",
		"@tanstack/react-router": "1.168.7",
		"@tanstack/react-router-ssr-query": "1.166.10",
		"@tanstack/react-start": "1.167.12",
		"@use-pico/client": "workspace:*",
		"@use-pico/cls": "workspace:*",
		"@use-pico/common": "workspace:*",
		"@use-pico/server": "workspace:*",
		"@zbav-se.me/sdk": "workspace:*",
		"@zbav-se.me/ui": "workspace:*",
		"better-auth": "1.5.6",
		"effect": "3.21.0",
		"kysely": "0.28.14",
		"luxon": "3.7.2",
		"minio": "8.0.7",
		"pg": "8.20.0",
		"pg-pool": "3.13.0",
		"pg-protocol": "1.13.0",
		"pgvector": "0.2.1",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"reflect-metadata": "0.2.2",
		"sonner": "2.0.7",
		"ts-pattern": "5.9.0",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@iconify/json": "2.2.455",
		"@iconify/tailwind4": "1.2.3",
		"@modyfi/vite-plugin-yaml": "1.1.1",
		"@playwright/test": "1.58.2",
		"@tailwindcss/vite": "4.2.2",
		"@tanstack/router-plugin": "1.167.8",
		"@types/bun": "1.3.11",
		"@types/luxon": "3.7.1",
		"@types/pg": "8.20.0",
		"@types/pg-pool": "2.0.7",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@types/terminal-kit": "2.5.7",
		"@typescript/native-preview": "7.0.0-dev.20260327.2",
		"@use-pico/vite-asset-size": "1.0.4",
		"@vitejs/plugin-react": "6.0.1",
		"cac": "7.0.0",
		"google-fonts-helper": "3.7.4",
		"knip": "6.0.6",
		"nitro": "3.0.260311-beta",

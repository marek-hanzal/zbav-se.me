{
	"name": "@zbav-se.me/server",
	"version": "workspace:*",
	"type": "module",
	"scripts": {
		"dev": "run-p dev:*",
		"dev:nitro": "PORT=3032 nitro dev --host 0.0.0.0",
		"dev:mcp": "DANGEROUSLY_OMIT_AUTH=true bunx @modelcontextprotocol/inspector",
		"build": "nitro build && bun ./cli/size.ts",
		"seed:core": "bun ./cli/seed-core.ts",
		"seed:interaction": "bun ./cli/seed-interaction.ts",
		"typecheck": "tsc --noEmit",
		"test": "bunx --bun vitest --run",
		"knip": "knip --include dependencies --no-config-hints"
	},
	"dependencies": {
		"@better-auth/passkey": "1.5.5",
		"@hono/zod-openapi": "1.2.2",
		"@modelcontextprotocol/sdk": "1.27.1",
		"@scalar/hono-api-reference": "0.10.3",
		"@use-pico/common": "workspace:*",
		"better-auth": "1.5.5",
		"cac": "7.0.0",
		"effect": "3.20.0",
		"hono": "4.12.8",
		"jose": "6.2.1",
		"kysely": "0.28.12",
		"luxon": "3.7.2",
		"minio": "8.0.7",
		"pg": "8.20.0",
		"pgvector": "0.2.1",
		"terminal-kit": "3.1.2",
		"ts-pattern": "5.9.0",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@effect/language-service": "0.80.0",
		"@modelcontextprotocol/inspector": "0.21.1",
		"@types/bun": "1.3.10",
		"@types/luxon": "3.7.1",
		"@types/node": "25.5.0",
		"@types/pg": "8.18.0",
		"@types/terminal-kit": "2.5.7",
		"@typescript/native-preview": "7.0.0-dev.20260317.1",
		"@use-pico/tsconfig": "5.0.0",
		"knip": "5.87.0",
		"nitro": "3.0.1-alpha.2",
		"npm-run-all2": "8.0.4",
		"rolldown": "1.0.0-rc.9",
		"typescript": "beta",
		"vitest": "4.1.0"
	},
	"main": "src/index.ts",
	"types": "src/index.ts",
	"private": true
}

{
	"name": "@zbav-se.me/server",
	"version": "workspace:*",
	"type": "module",
	"scripts": {
		"dev": "run-p dev:*",
		"dev:nitro": "portless api.zbav-se.me nitro dev --host 0.0.0.0",
		"dev:mcp": "DANGEROUSLY_OMIT_AUTH=true bunx @modelcontextprotocol/inspector",
		"build": "nitro build",
		"e2e:build": "nitro build --preset=node_server",
		"e2e:start": "portless --force api.zbav-se.me node .output/server/index.mjs",
		"e2e": "run-s e2e:build e2e:start",
		"seed:core": "bun ./cli/seed-core.ts",
		"seed:interaction": "bun ./cli/seed-interaction.ts",
		"typecheck": "tsc --noEmit",
		"test": "bunx --bun vitest --run",
		"knip": "knip --include dependencies --no-config-hints"
	},
	"dependencies": {
		"@better-auth/passkey": "1.5.6",
		"@hono/zod-openapi": "1.2.3",
		"@modelcontextprotocol/sdk": "1.28.0",
		"@scalar/hono-api-reference": "0.10.5",
		"@use-pico/common": "workspace:*",
		"@use-pico/server": "workspace:*",
		"better-auth": "1.5.6",
		"cac": "7.0.0",
		"effect": "3.21.0",
		"hono": "4.12.9",
		"jose": "6.2.2",
		"kysely": "0.28.14",
		"luxon": "3.7.2",
		"minio": "8.0.7",
		"pg": "8.20.0",
		"pgvector": "0.2.1",
		"terminal-kit": "3.1.2",
		"ts-pattern": "5.9.0",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@effect/language-service": "0.83.1",
		"@modelcontextprotocol/inspector": "0.21.1",
		"@types/bun": "1.3.11",
		"@types/luxon": "3.7.1",
		"@types/node": "25.5.0",
		"@types/pg": "8.20.0",
		"@types/terminal-kit": "2.5.7",
		"@typescript/native-preview": "7.0.0-dev.20260325.1",
		"@use-pico/tsconfig": "5.0.0",
		"knip": "6.0.5",
		"nitro": "3.0.260311-beta",
		"npm-run-all2": "8.0.4",
		"rolldown": "1.0.0-rc.12",
		"typescript": "beta",
		"vitest": "4.1.1"
	},
	"exports": {
		"./*": {
			"import": "./src/*/index.ts"
		}
	},
	"private": true
}

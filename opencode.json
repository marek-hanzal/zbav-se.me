{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"context-mode": {
			"type": "local",
			"command": [
				"context-mode"
			]
		}
	},
	"provider": {
		"lmstudio": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Obsidian LLM",
			"options": {
				"baseURL": "http://127.0.0.1:1234/v1"
			},
			"models": {
				"unsloth/glm-4.7-flash": {
					"name": "GLM 4.7 - Flash (8bit)"
				},
				"zai-org/glm-4.7-flash": {
					"name": "GLM 4.7 - Flash (Reasoning)"
				}
			}
		}
	},
	"plugin": [
		"context-mode"
	]
}

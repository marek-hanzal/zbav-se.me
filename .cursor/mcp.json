{
	"mcpServers": {
		"postgres": {
			"command": "bunx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-postgres",
				"postgresql://postgres:postgres@localhost:5432/zbav_se_me"
			]
		},
		"chrome-devtools": {
			"command": "bunx",
			"args": [
				"-y",
				"chrome-devtools-mcp@latest"
			]
		}
	}
}
